# pipeline staging — regenerable, and large
.kb/

# generated distributions of wiki/ (Claude Project export). Regenerable from
# the vault, and committing one duplicates the whole knowledge base.
exports/

__pycache__/
*.pyc
.DS_Store

# Obsidian is no longer generated by this pipeline. Ignore it entirely so that
# opening wiki/ in Obsidian by hand never dirties the repo.
wiki/.obsidian/

# The viewers and graph-data.js ARE committed: wiki/graph.html, wiki/chat.html and
# wiki/_meta/graph-data.js. wiki/_meta/chat-data.js is NOT — it embeds the whole
# wiki (>100 MB), over GitHub's file limit, and is regenerated by the build.
# Their vendored libraries are not — they are byte-for-byte
# copies of files this repo already commits under
# .claude/skills/knowledge-base/assets/vendor/, and init_wiki.py restores them.
# A fresh clone therefore needs one /kb-build before the graph renders offline.
wiki/_meta/vendor/
wiki/_meta/chat-data.js
